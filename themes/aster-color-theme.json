  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#546E7A",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "keyword.other.package",
        "keyword.other.import",
        "keyword.other.from",
        "keyword.other.as",
        "keyword.other.new",
        "keyword.other.property",
        "keyword.other.accessor",
        "storage",
        "storage.type",
        "storage.type.class",
        "storage.type.interface",
        "storage.type.struct",
        "storage.type.enum",
        "storage.type.exception",
        "storage.type.typedef",
        "storage.type.function",
        "storage.type.constructor",
        "storage.type.string",
        "storage.modifier",
        "variable.language",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#C792EA"
      }
    },
    {
      "scope": ["entity.name.function", "entity.name.function.call", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#82AAFF"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.enum",
        "entity.name.type.struct",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#FFCB6B"
      }
    },
    {
      "scope": ["entity.name.type.parameter"],
      "settings": {
        "foreground": "#FFCB6B",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["entity.name.namespace", "entity.name.namespace.package", "entity.name.namespace.alias", "entity.name.tag"],
      "settings": {
        "foreground": "#F07178"
      }
    },
    {
      "scope": ["variable", "variable.other", "identifier"],
      "settings": {
        "foreground": "#EEFFFF"
      }
    },
    {
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#F78C6C"
      }
    },
    {
      "scope": ["variable.other.property", "variable.other.member"],
      "settings": {
        "foreground": "#80CBC4"
      }
    },
    {
      "scope": ["variable.other.import"],
      "settings": {
        "foreground": "#B2CCD6"
      }
    },
    {
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#F78C6C"
      }
    },
    {
      "scope": ["constant.language"],
      "settings": {
        "foreground": "#F07178"
      }
    },
    {
      "scope": ["constant.language.wildcard"],
      "settings": {
        "foreground": "#89DDFF"
      }
    },
    {
      "scope": ["constant.other.enummember"],
      "settings": {
        "foreground": "#F78C6C"
      }
    },
    {
      "scope": ["constant.character.escape", "constant.character.format"],
      "settings": {
        "foreground": "#89DDFF"
      }
    },
    {
      "scope": ["constant.other", "constant.other.caps", "constant.character"],
      "settings": {
        "foreground": "#F78C6C"
      }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#C3E88D"
      }
    },
    {
      "scope": ["punctuation.definition.string"],
      "settings": {
        "foreground": "#C3E88D"
      }
    },
    {
      "scope": ["meta.interpolation", "punctuation.section.interpolation"],
      "settings": {
        "foreground": "#89DDFF"
      }
    },
    {
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#89DDFF"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.accessor",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#89DDFF"
      }
    },
    {
      "scope": ["punctuation.decorator"],
      "settings": {
        "foreground": "#F07178"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#C792EA"
      }
    },
    {
      "scope": ["markup.heading", "markup.bold"],
      "settings": {
        "foreground": "#FFCB6B",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#C792EA",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.underline.link", "markup.underline.link.markdown"],
      "settings": {
        "foreground": "#82AAFF",
        "fontStyle": "underline"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#F07178"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#F07178",
    "type": "#FFCB6B",
    "class": "#FFCB6B",
    "interface": "#FFCB6B",
    "struct": "#FFCB6B",
    "enum": "#FFCB6B",
    "typeParameter": {
      "foreground": "#FFCB6B",
      "italic": true
    },
    "parameter": "#F78C6C",
    "variable": "#EEFFFF",
    "property": "#80CBC4",
    "enumMember": "#F78C6C",
    "function": "#82AAFF",
    "method": "#82AAFF",
    "keyword": "#C792EA",
    "operator": "#89DDFF",
    "comment": {
      "foreground": "#546E7A",
      "italic": true
    },
    "variable.readonly": "#F78C6C",
    "property.readonly": "#F78C6C",
    "enumMember.readonly": "#F78C6C",
    "function.defaultLibrary": {
      "foreground": "#82AAFF",
      "italic": true
    },
    "method.defaultLibrary": {
      "foreground": "#82AAFF",
      "italic": true
    },
    "*.static": {
      "italic": true
    }
  }
}
